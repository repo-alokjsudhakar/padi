# Copy this file to .env for running on your own computer.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Needed to read PDFs. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Owner accounts: the email addresses that can add, edit and delete questions and read PDFs.
# Separate several with commas. Required on Vercel. On your own computer, leaving it empty
# makes everyone the owner.
ADMIN_EMAILS=you@example.com

# Google sign-in (optional). Create an OAuth client ID of type "Web application" in
# Google Cloud Console and add your site address (and http://localhost:3000) as an
# authorised JavaScript origin. Leave empty to offer email sign-in only.
GOOGLE_CLIENT_ID=

# Secret used to sign login cookies (optional). Any long random text.
# If empty, one is derived automatically.
SESSION_SECRET=

# Model used to read PDFs. Check https://docs.claude.com for current model names.
CLAUDE_MODEL=claude-sonnet-5-5

# Maximum length of each Claude reply (tokens).
MAX_TOKENS=8000

# Only for running locally.
PORT=3000

# Database (set automatically on Vercel when you add Upstash Redis from the Marketplace).
# Leave empty locally to use data/bank.json instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
