# Copy this file to .env for running on your own computer.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Needed to read PDFs. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Password that lets you add or edit papers and read PDFs. Required on Vercel.
# Visitors without it can still practise. Use a long, unique password.
ADMIN_PASSWORD=choose-a-long-password

# Model used to read PDFs. Check https://docs.claude.com for current model names.
CLAUDE_MODEL=claude-sonnet-5-5

# Maximum length of each Claude reply (tokens).
MAX_TOKENS=8000

# Only for running locally.
PORT=3000

# Database (set automatically on Vercel when you add Upstash Redis from the Marketplace).
# Leave empty locally to use data/bank.json instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
